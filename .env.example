# 9Router (OpenAI-compatible)
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=replace-with-your-key

# Text models are tried in this order. A fallback happens only for quota/token/rate-limit errors.
NINE_ROUTER_MODELS=cx/gpt-5.6-sol,ag/gemini-3.8-flash-medium,gc/gemini-3-pro-preview

# Set this to an image-capable model exposed by your 9Router instance.
NINE_ROUTER_IMAGE_MODEL=ag/gemini-3-pro-image-preview

# Runtime
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_REVISIONS=3
LLM_TIMEOUT_SECONDS=180

